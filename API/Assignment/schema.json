{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smart Bank Fund Transfer Request",
  "type": "object",
  "properties": {
    "fromAccount": {
      "type": "string",
      "pattern": "^SB[0-9]+$"
    },
    "toAccount": {
      "type": "string",
      "pattern": "^SB[0-9]+$"
    },
    "amount": {
      "type": "number",
      "minimum": 1,
      "maximum": 200000
    },
    "transferMode": {
      "type": "string",
      "enum": ["UPI", "IMPS", "NEFT"]
    },
    "remarks": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "fromAccount",
    "toAccount",
    "amount",
    "transferMode",
    "remarks"
  ],
  "additionalProperties": false
}
